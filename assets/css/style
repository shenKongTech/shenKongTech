.as-menu { width: 32px; height: 32px; flex-shrink: 0; border-radius: 9px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 14px; cursor: pointer; transition: 0.18s; }
.as-menu:hover { color: var(--text); border-color: var(--border-strong); background: rgba(148, 163, 184, 0.08); }
.as-drawer { position: absolute; left: 0; top: 0; bottom: 0; width: 272px; max-width: 84%; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: rgba(13, 19, 34, 0.98); border-right: 1px solid var(--border); transform: translateX(-102%); transition: transform 0.24s ease; z-index: 6; }
