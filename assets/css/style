/* NEXUS AI · 设计系统 */ :root {
  --bg: #070a14;
  --panel: rgba(17, 25, 44, 0.72);
  --border: rgba(148, 163, 184, 0.14);
  --border-strong: rgba(148, 163, 184, 0.26);
  --text: #e9edf8;
  --muted: #93a1bd;
  --muted-2: #6b7a99;
  --violet: #7c5cff;
  --violet-2: #a78bfa;
  --cyan: #22d3ee;
  --pink: #f472b6;
  --green: #34d399;
  --amber: #fbbf24;
  --red: #fb7185;
  --radius: 18px;
  --shadow: 0 20px 50px -20px rgba(2, 6, 23, 0.8);
  --sidebar-w: 254px;
  --font: "Inter", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", "Noto Sans SC", system-ui, -apple-system, sans-serif;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; }
h1, h2, h3, h4 { margin: 0; line-height: 1.25; letter-spacing: -0.01em; }
p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
::selection { background: rgba(124, 92, 255, 0.35); }
/* 背景装饰 */ .bg-decor { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
.blob { position: absolute; border-radius: 50%; filter: blur(110px); opacity: 0.5; }
.blob-a { width: 620px; height: 620px; left: -180px; top: -220px; background: radial-gradient(circle, rgba(124, 92, 255, 0.42), transparent 65%); }
.blob-b { width: 520px; height: 520px; right: -140px; top: 120px; background: radial-gradient(circle, rgba(34, 211, 238, 0.22), transparent 65%); }
.blob-c { width: 560px; height: 560px; left: 38%; bottom: -300px; background: radial-gradient(circle, rgba(244, 114, 182, 0.18), transparent 65%); }
.grid-lines {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(148, 163, 184, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148, 163, 184, 0.045) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at 40% 20%, #000 20%, transparent 78%);
}
/* 布局 */ .app-shell { position: relative; z-index: 1; display: flex; min-height: 100vh; }
.sidebar {
  width: var(--sidebar-w);
  flex: 0 0 var(--sidebar-w);
  height: 100vh;
  height: 100dvh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 22px 16px 18px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(11, 16, 32, 0.92), rgba(8, 12, 24, 0.86));
  border-right: 1px solid var(--border);
  z-index: 40;
}
.brand { display: flex; align-items: center; gap: 11px; padding: 4px 8px 22px; }
.brand-mark {
  width: 40px; height: 40px; border-radius: 12px;
  display: grid; place-items: center;
  background: linear-gradient(140deg, rgba(124, 92, 255, 0.22), rgba(34, 211, 238, 0.12));
  border: 1px solid rgba(124, 92, 255, 0.35);
  box-shadow: 0 0 24px -6px rgba(124, 92, 255, 0.5);
}
.brand-mark svg { width: 24px; height: 24px; }
.brand-text strong { display: block; font-size: 17px; letter-spacing: 0.08em; font-weight: 800; }
.brand-text strong span { background: linear-gradient(90deg, var(--violet-2), var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; margin-left: 3px; }
.brand-text small { display: block; font-size: 10.5px; color: var(--muted-2); letter-spacing: 0.18em; margin-top: 1px; }
.nav { display: flex; flex-direction: column; gap: 4px; flex: 1 1 auto; min-height: 0; overflow-y: auto; padding-right: 2px; }
.nav::-webkit-scrollbar { width: 4px; }
.nav::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.2); border-radius: 4px; }
.nav-item {
  display: flex; align-items: center; gap: 11px;
  padding: 10px 12px;
  border-radius: 11px;
  color: var(--muted);
  font-size: 13.5px;
  font-weight: 500;
  position: relative;
  transition: background 0.18s, color 0.18s, transform 0.18s;
}
.nav-item svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 18px; opacity: 0.9; }
.nav-item:hover { color: var(--text); background: rgba(148, 163, 184, 0.07); }
.nav-item.active {
  color: #fff;
  background: linear-gradient(90deg, rgba(124, 92, 255, 0.24), rgba(34, 211, 238, 0.08));
  box-shadow: inset 0 0 0 1px rgba(124, 92, 255, 0.28);
}
.nav-item.active::before {
  content: ""; position: absolute; left: -16px; top: 50%; transform: translateY(-50%);
  width: 3px; height: 20px; border-radius: 3px;
  background: linear-gradient(180deg, var(--violet-2), var(--cyan));
}
.nav-item.active svg { color: var(--violet-2); }
.sidebar-foot { padding-top: 14px; display: flex; flex-direction: column; gap: 10px; flex: 0 0 auto; }
.daily-goal {
  border: 1px solid var(--border);
  background: rgba(124, 92, 255, 0.06);
  border-radius: 13px;
  padding: 11px 13px;
}
.daily-goal-top { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); margin-bottom: 8px; }
.daily-goal-top b { color: var(--text); }
.daily-goal .progress { height: 5px; }
.user-mini { display: flex; align-items: center; gap: 9px; padding: 6px 4px 0; border-radius: 9px; color: var(--text); text-decoration: none; transition: background 0.18s; }
.user-mini:hover { background: rgba(124, 92, 255, 0.1); }
.user-mini:hover .u-name { color: #fff; }
.user-mini .u-name { font-size: 12.5px; font-weight: 600; }
.user-mini .u-lv { font-size: 10.5px; color: var(--muted-2); }
.user-mini .u-xp { margin-left: auto; font-size: 11px; color: var(--cyan); font-weight: 700; }
.avatar {
  width: 38px; height: 38px; border-radius: 50%;
  display: inline-grid; place-items: center;
  font-weight: 700; font-size: 15px; color: #fff;
  background: linear-gradient(140deg, #7c5cff, #22d3ee);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18), 0 4px 14px -4px rgba(124, 92, 255, 0.7);
  flex: 0 0 auto;
}
.avatar-sm { width: 32px; height: 32px; font-size: 13px; }
.avatar-lg { width: 74px; height: 74px; font-size: 28px; }
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar {
  position: sticky; top: 0; z-index: 30;
  display: flex; align-items: center; gap: 14px;
  height: 66px;
  padding: 0 30px;
  background: rgba(7, 10, 20, 0.7);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}
.topbar-title { font-size: 14px; font-weight: 600; letter-spacing: 0.01em; }
.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.streak-pill, .xp-pill {
  display: flex; align-items: center; gap: 6px;
  font-size: 12px; color: var(--muted);
  padding: 6px 11px; border-radius: 999px;
  border: 1px solid var(--border);
  background: rgba(17, 25, 44, 0.6);
  white-space: nowrap;
}
.streak-pill b { color: var(--amber); }
.xp-pill b { color: var(--text); }
.xp-dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg, var(--violet-2), var(--cyan)); box-shadow: 0 0 8px var(--violet); }
.icon-btn {
  width: 36px; height: 36px; border-radius: 10px;
  display: grid; place-items: center;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid var(--border);
  color: var(--text); cursor: pointer;
}
.icon-btn svg { width: 19px; height: 19px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
.icon-btn.mobile-menu-btn { display: none; }
.page { padding: 30px 32px 64px; max-width: 1280px; width: 100%; margin: 0 auto; animation: pageIn 0.45s ease both; }
@keyframes pageIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
.sidebar-backdrop { display: none; }
/* 通用组件 */ .card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
}
.panel { padding: 20px 22px; }
.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 16px; }
.panel-head h3 { font-size: 15px; font-weight: 650; display: flex; align-items: center; gap: 8px; }
.panel-head h3 svg { width: 16px; height: 16px; stroke: var(--muted); }
.panel-head .link { font-size: 12px; color: var(--muted); display: inline-flex; align-items: center; gap: 4px; }
.panel-head .link:hover { color: var(--cyan); }
.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
.eyebrow::before { content: ""; width: 18px; height: 1px; background: currentColor; opacity: 0.7; }
.muted { color: var(--muted); }
.small { font-size: 12px; }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  padding: 10px 17px; border-radius: 11px;
  font-size: 13px; font-weight: 600;
  border: 1px solid var(--border-strong);
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  cursor: pointer;
  transition: transform 0.16s, background 0.16s, box-shadow 0.16s, opacity 0.16s;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); background: rgba(148, 163, 184, 0.14); }
.btn:active { transform: translateY(0); }
.btn svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.btn-primary {
  background: linear-gradient(135deg, #7c5cff, #5b8cff 55%, #22d3ee);
  border-color: transparent; color: #fff;
  box-shadow: 0 10px 26px -10px rgba(124, 92, 255, 0.85);
}
.btn-primary:hover { background: linear-gradient(135deg, #8f73ff, #6d9bff 55%, #3dddf5); box-shadow: 0 14px 30px -10px rgba(124, 92, 255, 0.95); }
.btn-soft { background: rgba(124, 92, 255, 0.14); border-color: rgba(124, 92, 255, 0.35); color: #c4b5fd; }
.btn-soft:hover { background: rgba(124, 92, 255, 0.22); }
.btn-ghost { background: transparent; border-color: var(--border); color: var(--muted); }
.btn-sm { padding: 7px 12px; font-size: 12px; border-radius: 9px; }
.btn-tiny { padding: 5px 10px; font-size: 11px; border-radius: 8px; }
.btn-block { width: 100%; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.chip-row { display: flex; gap: 8px; flex-wrap: wrap; }
.chip {
  padding: 6px 13px; border-radius: 999px;
  border: 1px solid var(--border);
  background: rgba(148, 163, 184, 0.06);
  color: var(--muted); font-size: 12px; font-weight: 500; cursor: pointer;
  transition: all 0.16s;
}
.chip:hover { color: var(--text); border-color: var(--border-strong); }
.chip.active { background: rgba(124, 92, 255, 0.18); border-color: rgba(124, 92, 255, 0.5); color: #ded7ff; }
.tag {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10.5px; font-weight: 600; letter-spacing: 0.02em;
  color: var(--muted);
  padding: 3px 8px; border-radius: 6px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.1);
}
.badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px;
  background: rgba(124, 92, 255, 0.16); color: #c4b5fd;
  border: 1px solid rgba(124, 92, 255, 0.3);
}
.badge.green { background: rgba(52, 211, 153, 0.12); color: var(--green); border-color: rgba(52, 211, 153, 0.3); }
.badge.amber { background: rgba(251, 191, 36, 0.12); color: var(--amber); border-color: rgba(251, 191, 36, 0.3); }
.progress { height: 7px; border-radius: 999px; background: rgba(148, 163, 184, 0.13); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--violet), var(--cyan)); transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
.progress-fill.green { background: linear-gradient(90deg, #059669, var(--green)); }
.progress-fill.amber { background: linear-gradient(90deg, #d97706, var(--amber)); }
/* 页面头 */ .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 22px; flex-wrap: wrap; }
.page-head h1 { font-size: clamp(24px, 2.4vw, 31px); font-weight: 750; }
.page-head .sub { color: var(--muted); font-size: 13px; margin-top: 6px; max-width: 620px; }
.page-head .actions { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
/* 总览 Hero */ .hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.45fr 0.85fr;
  gap: 26px;
  padding: 30px 32px;
  border-radius: 24px;
  background:
    radial-gradient(120% 150% at 0% 0%, rgba(124, 92, 255, 0.22), transparent 55%),
    radial-gradient(100% 140% at 100% 100%, rgba(34, 211, 238, 0.13), transparent 55%),
    linear-gradient(160deg, rgba(22, 30, 54, 0.9), rgba(12, 18, 34, 0.86));
  border: 1px solid rgba(124, 92, 255, 0.22);
  box-shadow: 0 30px 70px -30px rgba(76, 46, 170, 0.55);
  overflow: hidden;
  margin-bottom: 22px;
}
.hero::after {
  content: ""; position: absolute; right: -60px; top: -90px; width: 320px; height: 320px;
  border-radius: 50%; border: 1px dashed rgba(148, 163, 184, 0.14);
  pointer-events: none;
}
.hero-copy { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; }
.hero h1 { font-size: clamp(26px, 3vw, 36px); font-weight: 800; letter-spacing: -0.02em; }
.hero h1 .hi { background: linear-gradient(92deg, #c4b5fd 0%, #8be9fd 60%, #5eead4 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero p.lead { color: #a9b6d0; font-size: 13.5px; margin-top: 12px; max-width: 520px; }
.hero p.lead b { color: var(--text); }
.hero-actions { display: flex; gap: 10px; margin-top: 22px; flex-wrap: wrap; }
.hero-meta { display: flex; gap: 22px; margin-top: 24px; flex-wrap: wrap; }
.hero-meta .hm { display: flex; flex-direction: column; gap: 2px; }
.hero-meta .hm b { font-size: 17px; font-weight: 700; }
.hero-meta .hm span { font-size: 11px; color: var(--muted-2); }
.level-panel {
  position: relative; z-index: 1;
  border-radius: 18px;
  padding: 20px;
  background: rgba(8, 12, 24, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.14);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
  backdrop-filter: blur(10px);
}
.ring-wrap { position: relative; width: 148px; height: 148px; }
.ring-wrap svg { width: 148px; height: 148px; transform: rotate(-90deg); }
.ring-bg { fill: none; stroke: rgba(148, 163, 184, 0.13); stroke-width: 9; }
.ring-fg { fill: none; stroke: url(#ringGrad); stroke-width: 9; stroke-linecap: round; transition: stroke-dashoffset 0.9s cubic-bezier(0.22, 1, 0.36, 1); filter: drop-shadow(0 0 6px rgba(124, 92, 255, 0.55)); }
.ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring-center .lv-label { font-size: 10px; letter-spacing: 0.2em; color: var(--muted-2); text-transform: uppercase; }
.ring-center .lv-num { font-size: 36px; font-weight: 800; line-height: 1.1; background: linear-gradient(135deg, #c4b5fd, #67e8f9); -webkit-background-clip: text; background-clip: text; color: transparent; }
.ring-center .lv-title { font-size: 11.5px; color: var(--muted); margin-top: 1px; }
.level-xp { width: 100%; }
.level-xp .row { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-bottom: 7px; }
.level-xp .row b { color: var(--text); }
.level-xp .hint { font-size: 10.5px; color: var(--muted-2); text-align: center; margin-top: 8px; }
/* 统计卡 */ .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
.stat-card { padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; position: relative; overflow: hidden; }
.stat-card::before { content: ""; position: absolute; right: -24px; top: -24px; width: 90px; height: 90px; border-radius: 50%; background: radial-gradient(circle, rgba(124, 92, 255, 0.16), transparent 70%); }
.stat-top { display: flex; align-items: center; justify-content: space-between; }
.stat-label { font-size: 11.5px; color: var(--muted); }
.stat-icon { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; font-size: 14px; color: #b3a6ff; background: rgba(148, 163, 184, 0.08); border: 1px solid var(--border); }
.ui-ico { display: inline-block; vertical-align: -2px; flex: none; }
.stat-value { font-size: 25px; font-weight: 750; letter-spacing: -0.02em; margin-top: 2px; }
.stat-value small { font-size: 12px; font-weight: 500; color: var(--muted); margin-left: 3px; }
.stat-foot { font-size: 10.5px; color: var(--muted-2); }
/* 布局列 */ .layout { display: grid; grid-template-columns: 1.55fr 1fr; gap: 18px; align-items: start; }
.stack { display: flex; flex-direction: column; gap: 18px; }
/* 图表 */ .chart { display: flex; align-items: flex-end; gap: 10px; height: 160px; padding-top: 6px; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
.chart-bar-wrap { width: 100%; max-width: 34px; height: 120px; display: flex; align-items: flex-end; border-radius: 8px; background: rgba(148, 163, 184, 0.06); overflow: hidden; }
.chart-bar { width: 100%; border-radius: 8px; background: linear-gradient(180deg, #8b7bff, #22d3ee); min-height: 4px; transition: height 0.7s cubic-bezier(0.22, 1, 0.36, 1); position: relative; }
.chart-bar.zero { background: rgba(148, 163, 184, 0.14); }
.chart-bar.today { background: linear-gradient(180deg, #f472b6, #7c5cff); box-shadow: 0 0 18px -4px rgba(244, 114, 182, 0.7); }
.chart-label { font-size: 10.5px; color: var(--muted-2); }
.chart-label.today { color: var(--pink); font-weight: 700; }
.chart-val { font-size: 10px; color: var(--muted); font-weight: 600; }
.chart-summary { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }
.chart-summary b { font-size: 22px; font-weight: 750; }
.chart-summary span { font-size: 11.5px; color: var(--muted); }
/* 继续学习卡片 */ .continue-card { position: relative; overflow: hidden; padding: 20px 22px; }
.continue-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(90% 130% at 100% 0%, rgba(124, 92, 255, 0.16), transparent 60%); pointer-events: none; }
.continue-top { display: flex; align-items: center; gap: 13px; margin-bottom: 14px; position: relative; }
.course-icon {
  width: 46px; height: 46px; border-radius: 13px; flex: 0 0 46px;
  display: grid; place-items: center;
  font-size: 21px; font-weight: 700;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
}
.course-title { font-size: 15px; font-weight: 650; }
.course-sub { font-size: 11.5px; color: var(--muted); margin-top: 1px; }
.continue-meta { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 9px; margin-bottom: 7px; }
.continue-actions { display: flex; gap: 8px; margin-top: 14px; }
/* 课程卡 */ .stage-block { margin-bottom: 26px; }
.stage-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.stage-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 9px; box-shadow: 0 0 12px currentColor; background: currentColor; }
.stage-head h2 { font-size: 16px; font-weight: 700; }
.stage-head .stage-desc { font-size: 11.5px; color: var(--muted-2); }
.stage-head .stage-count { margin-left: auto; font-size: 11px; color: var(--muted); }
.course-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
.course-card { padding: 18px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s; position: relative; overflow: hidden; cursor: pointer; }
.course-card:focus-visible { outline: 2px solid rgba(124, 92, 255, 0.7); outline-offset: 2px; }
.course-card:hover { transform: translateY(-3px); border-color: rgba(124, 92, 255, 0.4); box-shadow: 0 26px 40px -26px rgba(124, 92, 255, 0.6); }
.course-card-top { display: flex; align-items: flex-start; gap: 11px; }
.course-card .course-icon { width: 42px; height: 42px; flex: 0 0 42px; font-size: 19px; }
.course-card .course-title { font-size: 14px; }
.course-card .course-sub { font-size: 11px; }
.course-desc { font-size: 11.5px; color: var(--muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.course-meta { display: flex; gap: 12px; font-size: 10.5px; color: var(--muted-2); flex-wrap: wrap; }
.course-meta span { display: inline-flex; align-items: center; gap: 4px; }
.course-tags { display: flex; gap: 5px; flex-wrap: wrap; }
.course-card-foot { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
.course-icon.icon-img { overflow: hidden; padding: 0; }
.course-icon.icon-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
