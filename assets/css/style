.as-conv-title { font-size: 12px; font-weight: 620; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.as-conv-meta { font-size: 10px; color: var(--muted-2); margin-top: 2px; }
.as-conv-del { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 7px; border: 0; background: transparent; color: var(--muted-2); cursor: pointer; font-size: 11px; }
