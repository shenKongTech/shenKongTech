.as-conv { display: flex; align-items: center; gap: 8px; padding: 9px 11px; border-radius: 11px; border: 1px solid transparent; background: rgba(148, 163, 184, 0.05); cursor: pointer; transition: 0.16s; }
.as-conv:hover { border-color: var(--border-strong); }
.as-conv.active { background: rgba(124, 92, 255, 0.12); border-color: rgba(124, 92, 255, 0.4); }
